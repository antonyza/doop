// ==========================================================================
// Meta-annotations helper:
//
// Modules list the annotations that play a role.
// The helper turns them into contract relations and follows meta-annotation
// chains (@Service carries @Component).
// Rules TODO
// ==========================================================================


// --------------------------------------------------------------------------
// For contracts/di.dl
// --------------------------------------------------------------------------


// Spring: @Component
.decl Bean_Annotation(?annotation:Annotation)


// Jakarta: @Entity
.decl FrameworkInstantiatedType_Annotation(?annotation:Annotation)


// Spring: @Bean
.decl BeanProducerMethod_Annotation(?annotation:Annotation)


// Spring: @Service
.decl Id_Annotation(?annotation:Annotation)


// Spring: @Primary
.decl Preferred_Annotation(?annotation:Annotation)


// Spring: @Autowired
// Jakarta: @Inject
.decl Injected_Annotation(?annotation:Annotation)


// Jakarta: @Resource
.decl InjectedByName_Annotation(?annotation:Annotation)


// Spring: @Qualifier
// Jakarta: @Named
.decl Qualifier_Annotation(?annotation:Annotation)





// --------------------------------------------------------------------------
// For contracts/entry.dl
// --------------------------------------------------------------------------


// Spring: @RequestMapping (covers @GetMapping etc...)
.decl RequestEntryPoint_Annotation(?annotation:Annotation)

// Spring: @KafkaListener
.decl MessageEntryPoint_Annotation(?annotation:Annotation)

// Jakarta: @PostConstruct
.decl LifecycleEntryPoint_Annotation(?annotation:Annotation)

// Spring: @Scheduled
.decl EventEntryPoint_Annotation(?annotation:Annotation)

// Spring: @Configuration
.decl EntryPointClass_Annotation(?annotation:Annotation)
