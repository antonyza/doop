// ==========================================================================
// Dependency injection contract:
//
// Which classes are beans, how they are named
// and which are the injection points.
// ==========================================================================




// --------------------------------------------------------------------------
// Which classes the framework creates
// --------------------------------------------------------------------------


// The framework creates instances of two kinds of class:
//   1) Beans: registered in the container, so they can be injected into other classes.
//   2) Other classes the framework creates but does not register, so they are
//      never injected anywhere. Example: JPA entities (@Entity).
// Every Bean is also a FrameworkInstantiatedType (the engine adds them), so
// modules only need to list the classes of kind 2 in FrameworkInstantiatedType.


// Every class the framework creates. The engine marks its constructors as
// entry points and creates a mock instance.
// Jakarta: @Entity
.decl FrameworkInstantiatedType(?class:ClassType)


// Modules list the ones declared in the code.
// The engine adds the ones its producer methods create (BeanProducerMethod).
// Spring: @Component (and @Service, @Repository, @Controller via meta-annotations)
.decl Bean(?class:ClassType)


// Methods whose return value becomes a bean.
// DI engine will find out the produced type from the method body and its return type
// and add it to Bean.
// Spring: @Bean on a method
// Jakarta: @Produces on a method
.decl BeanProducerMethod(?method:Method)





// --------------------------------------------------------------------------
// Names and preference
// --------------------------------------------------------------------------
// Modules write every name a bean answers to.
// Thats the one typed in the code and/or the default the framework gives.


// Spring: @Service("userServ"). Default: decapitalized class name (userService)
.decl Bean_Id(?class:ClassType, ?id:symbol)


// Spring: @Bean(name = "x"). Default: the method name
.decl BeanProducerMethod_Id(?method:Method, ?id:symbol)


// Wins when several beans fit one slot.
// Spring: @Primary on a class
.decl PreferredBean(?class:ClassType)

// Same.
// Spring: @Primary on a @Bean method
.decl PreferredBeanProducerMethod(?method:Method)

// Bean preference is more complicated than this for Spring and Jakarta so TODO




// --------------------------------------------------------------------------
// Injection points
// --------------------------------------------------------------------------
// A constructor can be an injection point too. It goes in InjectedMethod when
// the framework calls it with beans for its parameters.
// Spring: @Autowired on it or nothing if the class has only one constructor
// Jakarta: @Inject on it


// A field the framework fills, choosing the bean by type.
// Spring: @Autowired
// Jakarta: @Inject
.decl InjectedField(?field:Field)


// A method the framework calls with beans for its parameters.
// Spring: @Autowired on a setter or constructor
// Jakarta: @Inject on a method or constructor
.decl InjectedMethod(?method:Method)


// A field the framework fills, looking the bean up by name first.
// Jakarta: @Resource
.decl InjectedFieldByName(?field:Field)


// A method the framework calls with beans, looked up by name first.
// Jakarta: @Resource
.decl InjectedMethodByName(?method:Method)


// Narrows an InjectedField to the bean called "x".
// Spring: @Qualifier("x")
// Jakarta: @Named("x")
.decl InjectedField_QualifierName(?field:Field, ?name:symbol)
