// ==========================================================================
// Entry point contract:
//
// Methods and classes the framework calls although
// no code in the program does.
// ==========================================================================




// --------------------------------------------------------------------------
// Entry methods by what triggers the call
// --------------------------------------------------------------------------
// The engine adds the four kinds and all methods of EntryPointClass
// to mainAnalysis.EntryPointMethod.
// Split apart for taint.


// One call per client request.
// Spring: @GetMapping, @PostMapping etc..
// Jakarta: @GET, @POST etc...
.decl RequestEntryPoint(?method:Method)


// One call per message.
// Spring: @KafkaListener
.decl MessageEntryPoint(?method:Method)


// Once when the framework creates or ends something.
// Jakarta: @PostConstruct, @PreDestroy
.decl LifecycleEntryPoint(?method:Method)


// Any other trigger inside the program.
// Spring: @Scheduled, @EventListener, @ExceptionHandler
.decl EventEntryPoint(?method:Method)





// --------------------------------------------------------------------------
// Entry classes
// --------------------------------------------------------------------------

// The framework may call any method of the class and we cannot tell which.
// All its methods become entry points.
// Spring: @Configuration
.decl EntryPointClass(?class:ClassType)
