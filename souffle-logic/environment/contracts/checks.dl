// ==========================================================================
// Contract checks:
//
// Sanity checks on contract rows since Souffle accepts, for example,
// a method where a field is expected, since all types are symbols.
// These rules list such rows in the output (ContractProblem.csv)
// without failing, so mistakes in spec and framework rules are visible.
// ==========================================================================


.decl ContractProblem(?table:symbol, ?value:symbol, ?problem:symbol)
.output ContractProblem


ContractProblem("ExternallyCreatedType", ?type, "Not a class or interface") :-
  creation.ExternallyCreatedType(?type),
  !isClassType(?type),
  !isInterfaceType(?type).

ContractProblem("InjectionTarget", ?class, "Not a class") :-
  injection.InjectionTarget(?class),
  !isClassType(?class).

ContractProblem("EntryPoint", ?method, "Not a method") :-
  entry.EntryPoint(?method),
  !isMethod(?method).

ContractProblem("InjectedField", ?field, "Not a field") :-
  injection.InjectedField(?field),
  !isField(?field).

ContractProblem("InjectedParam", ?param, "Not a formal parameter") :-
  injection.InjectedParam(?param),
  !FormalParam(_, _, ?param).

ContractProblem("InjectedWith", ?source, "Source is not a class, interface, method or field") :-
  injection.InjectedWith(_, ?source),
  !isClassType(?source),
  !isInterfaceType(?source),
  !isMethod(?source),
  !isField(?source).

// An object of the class or interface must fit the type of the slot.
// Only class and interface sources, since a method may declare a wider return type
// (e.g. Object) and still return the right object.
// Types missing from the facts can also show up here.
ContractProblem("InjectedWith", ?source, "Class or interface does not fit the type of the slot") :-
  injection.InjectedWith(?slot, ?source),
  ( isClassType(?source) ; isInterfaceType(?source) ),
  ( Field_Type(?slot, ?type) ; Var_Type(?slot, ?type) ),
  !basic.SubtypeOf(?source, ?type).

// The check that a spec or framework fills only slots of the classes it injects into
// is in contracts/injection.dl, since it needs each file's own rows.
