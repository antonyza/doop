// ==========================================================================
// Implied rows:
//
// Rows that are always true when another row exists, whatever the framework
// (e.g.: if the framework fills a parameter, it also calls the method),
// so specs and frameworks don't need to repeat or ever forget these combinations.
// Framework choices (e.g. which constructor of a created class runs) don't belong here.
// ==========================================================================




// --------------------------------------------------------------------------
// Injection -> Injection
// --------------------------------------------------------------------------

// A field or parameter with an InjectedWith row is injected.
injection.InjectedField(?slot) :-
  injection.InjectedWith(?slot, _),
  isField(?slot).

injection.InjectedParam(?slot) :-
  injection.InjectedWith(?slot, _),
  isVar(?slot).




// --------------------------------------------------------------------------
// Injection -> Entry
// --------------------------------------------------------------------------

// Only the caller of a method passes its arguments.
// So if the framework fills a parameter, it also calls the method.
entry.EntryPoint(?method) :-
  injection.InjectedParam(?param),
  FormalParam(_, ?method, ?param).


// The framework calls a method to get what it puts into a slot.
entry.EntryPoint(?method) :-
  injection.InjectedWith(_, ?method),
  isMethod(?method).




// --------------------------------------------------------------------------
// Injection -> Creation
// --------------------------------------------------------------------------

// A class or interface given to a slot means the mock object the engine made for it,
// so it must have one.
creation.ExternallyCreatedType(?type) :-
  injection.InjectedWith(_, ?type),
  ( isClassType(?type) ; isInterfaceType(?type) ).




// --------------------------------------------------------------------------
// Entry -> Creation
// --------------------------------------------------------------------------

// A constructor only runs when an object of exactly its class is created
// (with new or reflection), so if the framework calls it, it creates the object.
creation.ExternallyCreatedType(?class) :-
  entry.EntryPoint(?ctor),
  Method_SimpleName(?ctor, "<init>"),
  Method_DeclaringType(?ctor, ?class).
